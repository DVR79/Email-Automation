# Copy to .env for local development. Never commit the real .env.

# Database (PostgreSQL). Use a Neon or Vercel Postgres connection string.
# Local development also uses Postgres now; point this at your dev database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Base URL used by tracking links (open pixel, click redirect, unsubscribe).
# Local: http://localhost:3000   Production: your deployed URL.
APP_URL="http://localhost:3000"

# Email delivery.
# Option A (production, recommended on Vercel): Resend HTTP API.
#   Set this and sends go through Resend. The from address domain must be
#   verified in Resend (or use onboarding@resend.dev to your own address).
# RESEND_API_KEY=""

# Option B (local development): SMTP, defaults to Mailpit (localhost:1025, UI :8025).
# Used only when RESEND_API_KEY is not set.
SMTP_HOST="localhost"
SMTP_PORT="1025"
# SMTP_USER=""
# SMTP_PASS=""

MAIL_FROM="Sendrift <hello@sendrift.local>"
